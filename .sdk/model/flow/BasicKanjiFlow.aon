# BasicKanjiFlow

main: kit: flow: BasicKanjiFlow:
{
  entity: "kanji",
  kind: "basic",
  name: "BasicKanjiFlow",
  step: [
    {
      input: {
        ref: "kanji_ref01",
        srcdatavar: "kanji_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "kanji01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-kanji_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicKanjiFlow"
}