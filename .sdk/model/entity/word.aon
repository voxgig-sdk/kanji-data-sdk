# Entity: word

main: kit: entity: word: {

  alias: field: {}

  fields: [
    {
      name: "meanings"
      req: false
      short: "Meanings of the word"
      type: "`$ARRAY`"
    }
    {
      name: "variants"
      req: false
      short: "Different written and pronunciation variants"
      type: "`$ARRAY`"
    }
  ]

  name: "word"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "猫"
                kind: "param"
                name: "id"
                orig: "character"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/words/{character}"
          parts: [
            "words"
            "{id}"
          ]
          rename: {
            param: {
              character: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
