# Entity: kanji

main: kit: entity: kanji: {

  alias: field: {}

  fields: [
    {
      name: "grade"
      req: false
      short: "School grade level (1-6 for kyōiku kanji, 8 for remaining jōyō kanji)"
      type: "`$INTEGER`"
    }
    {
      name: "heisig_en"
      req: false
      short: "Heisig keyword in English"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "jlpt"
      req: false
      short: "JLPT (Japanese Language Proficiency Test) level (1-5)"
      type: "`$INTEGER`"
    }
    {
      name: "kanji"
      req: false
      short: "The kanji character"
      type: "`$STRING`"
    }
    {
      name: "kun_readings"
      req: false
      short: "Kun (Japanese) readings in hiragana"
      type: "`$ARRAY`"
    }
    {
      name: "meanings"
      req: false
      short: "English meanings of the kanji"
      type: "`$ARRAY`"
    }
    {
      name: "name_readings"
      req: false
      short: "Readings used in names"
      type: "`$ARRAY`"
    }
    {
      name: "on_readings"
      req: false
      short: "On (Chinese-derived) readings in katakana"
      type: "`$ARRAY`"
    }
    {
      name: "stroke_count"
      req: false
      short: "Number of strokes in the kanji"
      type: "`$INTEGER`"
    }
    {
      name: "unicode"
      req: false
      short: "Unicode codepoint in hexadecimal"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "kanji"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "猫"
                kind: "param"
                name: "id"
                orig: "character"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/kanji/{character}"
          parts: [
            "kanji"
            "{id}"
          ]
          rename: {
            param: {
              character: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
